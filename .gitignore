# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# Logs & env
*.log
.env

# Knowrary：本地 LLM 配置（含密钥），模板是 .knowrary/llm.example.json
*.local.json

# Obsidian（vault = 仓库根目录）
.obsidian/workspace*.json
.obsidian/cache

# Knowrary：写回前快照不进版本库
.knowrary/backup/

# Knowrary：index.json 是可重建的派生缓存（knowrary index 随时重建）
.knowrary/index.json

# Day-Info：推送凭证（PAT / Deploy Key），绝不入库
.secrets/

# ---------------------------------------------------------------------------
# Knowrary：个人流水数据不入库
#
# 仓库是公开的，而 .knowrary/ 里混着两类东西：**成果**（手工摆位、学习计划——丢了要重做，
# 值得进版本库当备份）和**流水**（我问过什么、花了多少钱、哪道题答错了——进了公开历史就收不回来）。
# 下面这几条只挡流水，layout.json / layouts/ / plans.json / projects.json / coach* 照旧入库。
#
# **注意：.gitignore 管不住已经被跟踪的文件。** 这个坑踩过一次——`.knowrary/chat/` 这条
# 2026-09-16 就写了，但那三个文件早已被 git 跟踪，规则在这儿摆着完全没生效，
# 对话内容照样一路进了公开历史。以后往这里加规则，**必须同时**跑一次：
#     git rm -r --cached <路径>      # 只从索引移除，磁盘上的文件不动
# 然后 `git ls-files .knowrary/` 复核一遍，确认它真的不在跟踪列表里了。
# ---------------------------------------------------------------------------

# 对话留档是过程不是知识（F10.7），按月分文件，找旧对话用 grep
.knowrary/chat/

# 调用量与花费
.knowrary/llm-usage.json

# 答题与复习流水：答错了什么、什么时候复习的
.knowrary/quiz-log.json
.knowrary/review-log.json
.knowrary/question-pool.json
